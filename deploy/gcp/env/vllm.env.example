# /etc/scout/vllm.env  (root:root, mode 600).
# Bearer key between the gateway and vLLM (localhost only). Any long random string; the same value goes in
# gateway.env as SCOUT_LLM_API_KEY.
VLLM_API_KEY=
# Only needed while the model repo is private or gated.
HF_TOKEN=
# bf16 (default, fits an 80 GB A100) or fp8 (weight-only FP8, more KV cache headroom).
WAYFINDER_QUANT=bf16
# WAYFINDER_MODEL=hweller1/wayfinder-glimmer-30b
# WAYFINDER_MAX_MODEL_LEN=65536
# WAYFINDER_GPU_UTIL=0.92
# WAYFINDER_MAX_SEQS=32
HF_HOME=/opt/wayfinder/hf
HF_HUB_DISABLE_TELEMETRY=1
