# /etc/scout/gateway.env  (root:root, mode 600). Copy this file, fill it in, or let fetch_secrets.sh write it from
# GCP Secret Manager. Never commit the filled-in file.
TURBOPUFFER_API_KEY=
VOYAGE_API_KEY=
# base64 of 32 random bytes each:  python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Reuse the values of an earlier gateway to keep its index and keys readable; new values start an empty index.
SCOUT_MASTER_KEY=
SCOUT_PEPPER=
# Chat upstream: vLLM on this VM. The key is the same value as VLLM_API_KEY in vllm.env.
SCOUT_LLM_URL=http://127.0.0.1:8000/v1
SCOUT_LLM_API_KEY=
SCOUT_LLM_MODEL=wayfinder-glimmer
SCOUT_LLM_SAMPLING=sft
# Optional
# SCOUT_KEYS_NS=scout_dev_keys
# TURBOPUFFER_REGION=
# SCOUT_BIND_HOST=127.0.0.1
# SCOUT_BIND_PORT=8080
# SCOUT_KEY_CACHE_TTL_S=60
