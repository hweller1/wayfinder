{
  "$defs": {
    "NodeUpsert": {
      "additionalProperties": false,
      "properties": {
        "children_enc": {
          "title": "Children Enc",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{16,32}$",
          "title": "Id",
          "type": "string"
        },
        "node_hash": {
          "title": "Node Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "node_hash",
        "children_enc"
      ],
      "title": "NodeUpsert",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One page of the node rows (and node deletes) of the tree whose root is `new_root`. Rows are written\nto `{ns}__tree` now; the deletes are only recorded and run by `sync_commit` after the root write.",
  "properties": {
    "base_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Root"
    },
    "branch_id": {
      "pattern": "^[0-9a-f]{16,32}$",
      "title": "Branch Id",
      "type": "string"
    },
    "new_root": {
      "title": "New Root",
      "type": "string"
    },
    "node_deletes": {
      "items": {
        "pattern": "^[0-9a-f]{16,32}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Node Deletes",
      "type": "array"
    },
    "node_upserts": {
      "items": {
        "$ref": "#/$defs/NodeUpsert"
      },
      "maxItems": 500,
      "title": "Node Upserts",
      "type": "array"
    },
    "page": {
      "minimum": 0,
      "title": "Page",
      "type": "integer"
    },
    "pages": {
      "maximum": 400,
      "minimum": 1,
      "title": "Pages",
      "type": "integer"
    },
    "repo_id": {
      "pattern": "^[0-9a-f]{16,32}$",
      "title": "Repo Id",
      "type": "string"
    }
  },
  "required": [
    "repo_id",
    "branch_id",
    "new_root",
    "page",
    "pages"
  ],
  "title": "StageNodesReq",
  "type": "object"
}
