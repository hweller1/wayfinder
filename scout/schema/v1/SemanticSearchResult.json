{
  "$defs": {
    "IndexStatus": {
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage",
          "type": "number"
        },
        "files": {
          "default": 0,
          "title": "Files",
          "type": "integer"
        },
        "last_sync_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Sync At"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_enabled": {
          "title": "Semantic Enabled",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "ready",
            "partial",
            "absent"
          ],
          "title": "State",
          "type": "string"
        },
        "syncing": {
          "default": false,
          "title": "Syncing",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "coverage",
        "semantic_enabled"
      ],
      "title": "IndexStatus",
      "type": "object"
    },
    "SnippetHit": {
      "properties": {
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "source": {
          "enum": [
            "semantic",
            "grep",
            "read"
          ],
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "verified": {
          "default": true,
          "title": "Verified",
          "type": "boolean"
        },
        "why": {
          "maxLength": 300,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line",
        "why",
        "source",
        "snippet"
      ],
      "title": "SnippetHit",
      "type": "object"
    }
  },
  "properties": {
    "hits": {
      "items": {
        "$ref": "#/$defs/SnippetHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "index": {
      "$ref": "#/$defs/IndexStatus"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "hits",
    "index"
  ],
  "title": "SemanticSearchResult",
  "type": "object"
}
